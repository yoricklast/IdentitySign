    "eslint-plugin-svelte": "^2.30.0",
    "pdfjs-dist": "^3.5.141",
    "prettier": "^2.8.8",
    "prettier-plugin-svelte": "^2.10.1",
    "svelte": "^4.0.0",
    "svelte-check": "^3.4.3",
    "tslib": "^2.4.1",
